IMAGE_MAINNET=glif/lotus:statemarketdeals-v1.36.0-mainnet
RPC_FULLNODE_MAINNET=http://api-read-master-lotus-service.network:1234
BUCKET_NAME_MAINNET=marketdeals

IMAGE_CALIBRATION=glif/lotus:statemarketdeals-v1.36.0-calibration
RPC_FULLNODE_CALIBRATION=http://calibrationapi-0-lotus-service.network:1234
BUCKET_NAME_CALIBRATION=marketdeals-calibration

# Absolute path to an existing output directory on the Docker host
HOST_OUTPUT_DIR=/data/statemarketdeals
FILE_NAME=StateMarketDeals.json

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION="us-east-1"
